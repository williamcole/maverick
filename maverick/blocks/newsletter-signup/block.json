{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/newsletter-signup",
  "version": "1.0.0",
  "title": "Newsletter Signup",
  "category": "maverick",
  "icon": "email",
  "description": "Full-width navy band with eyebrow, heading, body copy, and an email signup form.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "The Friday Memo"
    },
    "heading": {
      "type": "string",
      "default": "One short note every Friday."
    },
    "body": {
      "type": "string",
      "default": "A two-minute read from the Maverick team — what we're seeing, what we're testing, and what's actually working across our client programs. No fluff, no sponsorships."
    },
    "placeholder": {
      "type": "string",
      "default": "you@yourcampaign.org"
    },
    "buttonLabel": {
      "type": "string",
      "default": "Subscribe →"
    },
    "formAction": {
      "type": "string",
      "default": ""
    },
    "successMessage": {
      "type": "string",
      "default": "Thanks — check your inbox to confirm."
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full"
    ]
  }
}