{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/timeline-item",
  "version": "1.0.0",
  "title": "Timeline Item",
  "category": "maverick",
  "icon": "clock",
  "description": "A single year/milestone row for a company history timeline. Stack multiple inside a group for a full timeline.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "year": {
      "type": "string",
      "default": "2024"
    },
    "title": {
      "type": "string",
      "default": "Milestone title."
    },
    "description": {
      "type": "string",
      "default": "Short description of this milestone."
    },
    "isLast": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  }
}