{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/press-item",
  "version": "1.0.0",
  "title": "Press Item",
  "category": "maverick",
  "icon": "media-document",
  "description": "A single press mention or release item. Two variants: 'coverage' (date + headline + outlet, external link row) and 'release' (badge + headline + excerpt, download/read link card).",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "variant": {
      "type": "string",
      "default": "coverage",
      "enum": [
        "coverage",
        "release"
      ]
    },
    "date": {
      "type": "string",
      "default": "Jan 1, 2024"
    },
    "outlet": {
      "type": "string",
      "default": "Publication"
    },
    "title": {
      "type": "string",
      "default": "Headline goes here."
    },
    "excerpt": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": "#"
    },
    "linkText": {
      "type": "string",
      "default": "Read →"
    }
  },
  "supports": {
    "html": false
  }
}