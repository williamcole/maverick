{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/topic-filter",
  "version": "1.0.0",
  "title": "Topic Filter",
  "category": "maverick",
  "icon": "filter",
  "description": "A row of pill-style category filter links, auto-populated from real WordPress categories. The active category is highlighted automatically.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Topics"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}