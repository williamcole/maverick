{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/featured-case",
  "version": "1.0.0",
  "title": "Featured Case",
  "category": "maverick",
  "icon": "star-filled",
  "description": "A large, single featured card — photo, badge, title, excerpt, and a read-more link. Supports two display modes: 'case' (result stat pill, sans headline) for case studies, and 'press' (byline/outlet, serif italic headline, no result pill) for a featured press mention.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "mode": {
      "type": "string",
      "default": "case",
      "enum": [
        "case",
        "press"
      ]
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "badgeText": {
      "type": "string",
      "default": "Featured · 2024"
    },
    "resultText": {
      "type": "string",
      "default": "+312% small-dollar donors"
    },
    "category": {
      "type": "string",
      "default": "U.S. Senate · Battleground"
    },
    "byline": {
      "type": "string",
      "default": "The Washington Post"
    },
    "title": {
      "type": "string",
      "default": "Case study title."
    },
    "excerpt": {
      "type": "string",
      "default": "Short summary of the case study."
    },
    "linkUrl": {
      "type": "string",
      "default": "#"
    },
    "linkText": {
      "type": "string",
      "default": "Read the case study"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  }
}