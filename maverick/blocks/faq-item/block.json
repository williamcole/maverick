{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/faq-item",
  "version": "1.0.0",
  "title": "FAQ Item",
  "category": "maverick",
  "icon": "editor-help",
  "description": "A single expandable question/answer row using native HTML details/summary — no JavaScript required. Stack several inside a group to build a full FAQ list.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "question": {
      "type": "string",
      "default": "Question goes here?"
    },
    "answer": {
      "type": "string",
      "default": "Answer goes here."
    },
    "isOpen": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  }
}