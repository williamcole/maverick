{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/pillar-card",
  "version": "1.0.0",
  "title": "Pillar Card",
  "category": "maverick",
  "icon": "admin-links",
  "description": "A link-out card with a label, title, description, and an animated arrow link — used to point to other key pages.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Services"
    },
    "title": {
      "type": "string",
      "default": "Pillar title."
    },
    "description": {
      "type": "string",
      "default": "Short description of this pillar."
    },
    "linkUrl": {
      "type": "string",
      "default": "#"
    },
    "linkText": {
      "type": "string",
      "default": "Learn more"
    }
  },
  "supports": {
    "html": false
  }
}