{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/testimonial-card",
  "version": "1.0.0",
  "title": "Testimonial Card",
  "category": "maverick",
  "icon": "format-quote",
  "description": "A client testimonial with quote, name, and role.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "quote": {
      "type": "string",
      "default": "Client testimonial goes here."
    },
    "name": {
      "type": "string",
      "default": "Full Name"
    },
    "role": {
      "type": "string",
      "default": "Title · Organization"
    },
    "initials": {
      "type": "string",
      "default": "AB"
    }
  },
  "supports": {
    "html": false
  }
}