{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/showcase-card",
  "version": "1.0.0",
  "title": "Showcase Card",
  "category": "maverick",
  "icon": "format-image",
  "description": "A case study card with image, category tag, title, description, and link.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "badgeLabel": {
      "type": "string",
      "default": "U.S. Senate"
    },
    "category": {
      "type": "string",
      "default": "Fundraising · Direct Response"
    },
    "title": {
      "type": "string",
      "default": "Campaign Title"
    },
    "description": {
      "type": "string",
      "default": "Short description of the campaign outcome."
    },
    "linkUrl": {
      "type": "string",
      "default": "#"
    },
    "linkText": {
      "type": "string",
      "default": "Read case study →"
    }
  },
  "supports": {
    "html": false,
    "align": false
  }
}