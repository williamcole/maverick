{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/principle-card",
  "version": "1.0.0",
  "title": "Principle Card",
  "category": "maverick",
  "icon": "yes-alt",
  "description": "A numbered principle card with title and description — used in 'What We Believe' style grids.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "number": {
      "type": "string",
      "default": "01"
    },
    "title": {
      "type": "string",
      "default": "Principle title."
    },
    "description": {
      "type": "string",
      "default": "Short description of this principle."
    }
  },
  "supports": {
    "html": false
  }
}