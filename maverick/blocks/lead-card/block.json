{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maverick/lead-card",
  "version": "1.0.0",
  "title": "Lead Card",
  "category": "maverick",
  "icon": "businessperson",
  "description": "A compact horizontal team card — round initial avatar beside name, title, and bio. Used for discipline leads / mid-tier team grids.",
  "textdomain": "maverick-blocks",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/style-index.css",
  "render": "file:./render.php",
  "attributes": {
    "initial": {
      "type": "string",
      "default": "A"
    },
    "name": {
      "type": "string",
      "default": "Full Name"
    },
    "title": {
      "type": "string",
      "default": "Job Title"
    },
    "bio": {
      "type": "string",
      "default": "Short bio goes here."
    }
  },
  "supports": {
    "html": false
  }
}