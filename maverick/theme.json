      "gradients": [
        {
          "slug": "navy-to-navy-deep",
          "gradient": "linear-gradient(135deg, #13294B 0%, #0a1429 100%)",
          "name": "Navy to Navy Deep"
        },
        {
          "slug": "hero-overlay",
          "gradient": "linear-gradient(180deg, rgba(10,20,41,0.25) 0%, rgba(19,41,75,0.15) 45%, rgba(10,20,41,0.65) 100%)",
          "name": "Hero Overlay"
        }
      ],
      "defaultGradients": false,
      "defaultDuotone": false,
      "duotone": [
        {
          "slug": "navy-gold",
          "colors": [
            "#13294B",
            "#BA912E"
          ],
          "name": "Navy and Gold"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display (Inter)",
          "fontFamily": "'Inter', system-ui, sans-serif"
        },
        {
          "slug": "serif",
          "name": "Serif (Instrument Serif)",
          "fontFamily": "'Instrument Serif', Georgia, serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "caption",
          "size": "12px",
          "name": "Caption"
        },
        {
          "slug": "body-sm",
          "size": "13px",
          "name": "Body Small"
        },
        {
          "slug": "body",
          "size": "15px",
          "name": "Body"
        },
        {
          "slug": "body-lg",
          "size": "18px",
          "name": "Body Large"
        },
        {
          "slug": "size-h4",
          "size": "22px",
          "name": "Heading 4"
        },
        {
          "slug": "size-h3",
          "size": "32px",
