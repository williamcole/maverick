        },
        {
          "slug": "100",
          "size": "100px",
          "name": "100"
        },
        {
          "slug": "120",
          "size": "120px",
          "name": "120"
        }
      ],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "layout": {
      "contentSize": "1320px",
      "wideSize": "1600px"
    },
    "custom": {
      "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
      "borderRadius": {
        "sm": "6px",
        "md": "8px",
        "lg": "10px",
        "pill": "100px",
        "circle": "50%"
      },
      "letterSpacing": {
        "tight": "-0.04em",
        "heading": "-0.035em",
        "base": "-0.02em",
        "none": "0em",
        "wide": "0.04em",
        "wider": "0.06em",
        "widest": "0.18em"
      },
      "lineHeight": {
        "display": "1.02",
        "heading": "1.04",
        "snug": "1.08",
        "normal": "1.15",
        "body": "1.45",
        "relaxed": "1.55"
      },
      "fontWeight": {
        "regular": "400",
        "semibold": "600",
        "bold": "700",
        "extrabold": "800"
      }
    },
    "appearanceTools": true,
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "card-hover",
          "shadow": "0 28px 48px rgba(19,41,75,0.12)",
          "name": "Card Hover"
        },
        {
          "slug": "card",
          "shadow": "0 4px 16px rgba(19,41,75,0.06)",
          "name": "Card"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "#fafaf7",
      "text": "#1a1a1a"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--display)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.55",
      "fontSmoothing": "antialiased"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "lineHeight": "1.1"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--size-h-1)",
          "fontWeight": "600",
          "lineHeight": "1.02",
          "letterSpacing": "-0.04em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--size-h-2)",
          "fontWeight": "500",
          "lineHeight": "1.05",
          "letterSpacing": "-0.035em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--size-h-3)",
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--navy)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--gold)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--body-sm)",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "26px",
            "right": "26px"
          }
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--caption)",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--size-h-4)",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "-0.02em"
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--line)"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontStyle": "italic",
          "fontSize": "var(--wp--preset--font-size--body-lg)",
          "lineHeight": "1.45"
        }
      },
      "core/navigation": {
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--body-sm)",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var(--wp--preset--color--body)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body)",
          "lineHeight": "1.55"
        }
      },
      "core/list": {
        "color": {
          "text": "var(--wp--preset--color--body)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body)",
          "lineHeight": "1.55"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--40)"
        }
      },
      "core/column": {
        "spacing": {
          "blockGap": "14px"
        }
      },
      "core/image": {
        "border": {
          "radius": "10px"
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--16)"
        }
      },
      "core/cover": {
        "spacing": {
          "blockGap": "24px"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "1.5rem"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "24px"
        }
      }
    },
    "spacing": {
      "blockGap": "0",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "40px",
        "right": "40px"
      }
    }
  },
