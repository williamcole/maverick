        },
        {
          "slug": "60",
          "size": "60px",
          "name": "60"
        },
        {
          "slug": "70",
          "size": "70px",
          "name": "70"
        },
        {
          "slug": "80",
          "size": "80px",
          "name": "80"
        },
        {
          "slug": "88",
          "size": "88px",
