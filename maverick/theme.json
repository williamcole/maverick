        },
        {
          "slug": "size-h2",
          "size": "44px",
          "name": "Heading 2"
        },
        {
          "slug": "size-h1",
          "size": "56px",
          "name": "Heading 1"
        },
        {
          "slug": "display",
          "size": "76px",
          "name": "Display"
        }
      ],
      "lineHeight": true,
      "letterSpacing": true
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "16",
          "size": "16px",
          "name": "16"
        },
        {
          "slug": "22",
